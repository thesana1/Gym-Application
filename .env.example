NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=replace-with-output-of-openssl-rand-base64-32
# Optional: comma-separated DNS servers for mongodb+srv lookups (fixes EBADRESP on some hotspots)
# MONGO_DNS_SERVERS=8.8.8.8,1.1.1.1
MONGO_URI=mongodb://localhost:27017/nextjs-starter

# Google OAuth — https://console.developers.google.com
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Cloudinary — https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Dodo Payments — Premium ($20/month) and consultations ($20) are created dynamically
DODO_PAYMENTS_API_KEY=your-api-key
DODO_PAYMENTS_WEBHOOK_KEY=your-webhook-signing-key
DODO_PAYMENTS_ENVIRONMENT=test_mode

# Nodemailer SMTP — server-only settings; leave unset until you configure a provider
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# false uses STARTTLS; use true for implicit TLS (usually port 465)
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=Gym Application

# AI features via OpenRouter (server-only; never expose to the browser)
OPENROUTER_API_KEY=your-openrouter-api-key
# Optional: comma-separated models tried in order (defaults to free models in src/shared/const/ai.const.ts)
# OPENROUTER_MODELS=baidu/ernie-5.5-flash-preview:free,inclusionai/ling-3.2-flash:free

# Optional: where owner alerts (new sign-ups, Premium start/end) are emailed
OWNER_NOTIFICATION_EMAIL=owner@example.com
